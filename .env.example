# ═══════════════════════════════════════════════════════════
# Coast Run — secrets template (safe to commit)
# Copy to .env and fill values. Never commit .env.
# ═══════════════════════════════════════════════════════════

# ── Pexels API — https://www.pexels.com/api/ ───────────────
PEXELS_API_KEY=
PEXELS_API_BASE_URL=https://api.pexels.com/v1
PEXELS_VIDEOS_BASE_URL=https://api.pexels.com/videos

# ── Kling AI API — https://app.klingai.com/global/dev ──────
# Official (Kuaishou): fill ACCESS + SECRET (JWT auth)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Third-party reseller only: fill this instead of AK/SK
KLING_API_KEY=

# Official default. Alt: https://api-singapore.klingai.com
KLING_BASE_URL=https://api.klingai.com

# ── Mixamo (Adobe) ──
# mixamo.com 로그인 → F12 → Application → Local Storage → access_token
MIXAMO_BEARER=

# ── Android emulator / device (adb) — read by Tools/Mcp/android_mcp_server.py ──
# Leave empty to default to %LOCALAPPDATA%\Android\Sdk
ANDROID_SDK_ROOT=
ANDROID_ADB=
ANDROID_EMULATOR=
ANDROID_AVD=CoastRun_ARM64
ANDROID_AVD_ALT=CoastRun_API30
ANDROID_PKG=com.jette.coastrun
ANDROID_ACTIVITY=com.unity3d.player.UnityPlayerActivity
